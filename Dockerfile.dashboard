# Dashboard image: same app code, but launches Streamlit instead of uvicorn.
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /code

RUN apt-get update && apt-get install -y --no-install-recommends \
        libgomp1 \
        curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements/base.txt /code/requirements/base.txt
RUN pip install --no-cache-dir -r /code/requirements/base.txt

COPY src /code/src

# The dashboard talks to the API container over the compose network and does
# not load model artifacts itself, but the base requirements install pandas,
# scikit-learn, and xgboost so both images stay identical and simple.

RUN useradd --create-home appuser && chown -R appuser:appuser /code
USER appuser

EXPOSE 8501

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -fsS -o /dev/null http://localhost:8501 || exit 1

CMD ["streamlit", "run", "src/dashboard.py", "--server.port", "8501", "--server.address", "0.0.0.0"]
